{
  "name": "bga-dracula-theme",
  "version": "1.0.1",
  "description": "A Dracula theme for boardgamearena.com, built on top of the official BGA dark theme",
  "dependencies": {
    "sass": "^1.30.0"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2"
  },
  "scripts": {
    "prebuild": "node scripts/write-version.js",
    "prewatch": "node scripts/write-version.js",
    "presize": "node scripts/write-version.js",
    "build": "npx sass --no-source-map ./src/style.scss ./dist/style.css --style=compressed && npx csso ./dist/style.css --output ./dist/style.css && npm run size",
    "watch": "npx sass --no-source-map ./src/style.scss ./dist/style.css --style=compressed --watch",
    "size": "node scripts/check-size.js",
    "release": "node scripts/release.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audabas/bga-dracula-theme.git"
  },
  "author": "audabas",
  "license": "LPRAB",
  "bugs": {
    "url": "https://github.com/audabas/bga-dracula-theme/issues"
  },
  "homepage": "https://github.com/audabas/bga-dracula-theme#readme"
}
